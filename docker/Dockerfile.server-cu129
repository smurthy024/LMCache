# LMCache server sidecar image for NVIDIA cu129 offload recipes.
# Build context must include exactly one lmcache-*.whl at repo root (dist/).
#
# Example:
#   docker build -f docker/Dockerfile.server-cu129 \
#     --build-arg BASE_IMAGE=vllm/vllm-openai:v0.27.1-cu129 \
#     -t ghcr.io/smurthy024/lmcache-server:abort4136-cu129 .

ARG BASE_IMAGE=vllm/vllm-openai:v0.27.1-cu129
FROM ${BASE_IMAGE}

COPY dist/lmcache-*.whl /tmp/lmcache.whl

RUN pip install --no-cache-dir /tmp/lmcache.whl && rm /tmp/lmcache.whl && \
    pip install --no-cache-dir --no-deps \
      cupy-cuda12x fastrlock opentelemetry-exporter-prometheus redis \
      sortedcontainers aiofile \
    || pip install --no-cache-dir \
      cupy-cuda12x fastrlock opentelemetry-exporter-prometheus redis \
      sortedcontainers aiofile

ENTRYPOINT ["lmcache"]
CMD ["server"]
